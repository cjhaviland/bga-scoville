{
	"$schema": "../../node_modules/bga-ts-template/schema/gameinfos.schema.json",

	// Game Externals and basic information
	"game_name": "Scoville",
	"publisher": "Tasty Minstrel Games",
	"publisher_website": "http://playtmg.com/",
	"publisher_bgg_id": 9499,
	"bgg_id": 145659,

	// Players
	"players": [2, 3, 4, 5, 6],
	"player_colors": ["0093D0", "00A94D", "F68E1E", "A54499", "EE3F34", "FFEE01"],
	"favorite_colors_support": true,
	"suggest_player_number": 4,
	"not_recommend_player_number": null,
	"disable_player_order_swap_on_rematch": false,

	// Game Clock
	"estimated_duration": 60,
	"fast_additional_time": 30,
	"medium_additional_time": 40,
	"slow_additional_time": 50,

	// Game Rankings
	"tie_breaker_description": "The tied player with the most coins",
	"losers_not_ranked": false,
	"solo_mode_ranked": false,
	"is_coop": 0,

	// BGA Game Information
	"is_beta": 1,
	"language_dependency": false,
	"game_interface_width":
	{
		// >= 320, <= 740
		"min": 740,
		// >= 740. null = no limit
		"max": null
	},

	//////// BGA SANDBOX ONLY PARAMETERS (DO NOT MODIFY)
	"is_sandbox": false,
	"turnControl": "simple"
	////////
}